{
	"name": "antigravity-token-monitor",
	"displayName": "Antigravity Token Monitor (Token 监控)",
	"description": "监控 Antigravity 会话的 Token 使用量与费用，并在仪表盘中可视化分析。",
	"version": "0.0.17",
	"publisher": "ddarkr",
	"icon": "icon.png",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ddarkr/antigravity-token-monitor"
	},
	"bugs": {
		"url": "https://github.com/ddarkr/antigravity-token-monitor/issues"
	},
	"homepage": "https://github.com/ddarkr/antigravity-token-monitor#readme",
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onView:antigravity-token-monitor.sidebarView",
		"onCommand:antigravity-token-monitor.openDashboard",
		"onCommand:antigravity-token-monitor.refreshNow",
		"onCommand:antigravity-token-monitor.exportNow",
		"onCommand:antigravity-token-monitor.resetCache"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "antigravity-token-monitor",
					"title": "Antigravity Token 监控",
					"icon": "$(graph)"
				}
			]
		},
		"views": {
			"antigravity-token-monitor": [
				{
					"type": "webview",
					"id": "antigravity-token-monitor.sidebarView",
					"name": "Token 概览"
				}
			]
		},
		"commands": [
			{
				"command": "antigravity-token-monitor.openDashboard",
				"title": "Antigravity Token 监控: 打开仪表盘",
				"icon": "$(graph)"
			},
			{
				"command": "antigravity-token-monitor.refreshNow",
				"title": "Antigravity Token 监控: 立即刷新",
				"icon": "$(sync)"
			},
			{
				"command": "antigravity-token-monitor.exportNow",
				"title": "Antigravity Token 监控: 导出分析会话",
				"icon": "$(export)"
			},
			{
				"command": "antigravity-token-monitor.resetCache",
				"title": "Antigravity Token 监控: 重置缓存",
				"icon": "$(trash)"
			}
		],
		"configuration": {
			"title": "Antigravity Token Monitor",
			"properties": {
				"antigravity-token-monitor.sessionRoot": {
					"type": "string",
					"default": "",
					"description": "自定义 Antigravity 会话根目录路径。留空则自动检测 ~/.gemini/antigravity-ide。"
				},
				"antigravity-token-monitor.debug": {
					"type": "boolean",
					"default": false,
					"description": "在 Antigravity Token Monitor 输出通道中显示详细调试日志。"
				},
				"antigravity-token-monitor.pollIntervalMs": {
					"type": "number",
					"default": 60000,
					"minimum": 10000,
					"description": "扩展重新扫描会话并重新计算 Token 使用量的时间间隔（毫秒）。"
				},
				"antigravity-token-monitor.historyLimit": {
					"type": "number",
					"default": 120,
					"minimum": 10,
					"description": "每个会话保留的历史快照数量。"
				},
				"antigravity-token-monitor.maxFileBytes": {
					"type": "number",
					"default": 524288,
					"minimum": 16384,
					"description": "Token 估算时读取文件的最大大小（字节）。"
				},
				"antigravity-token-monitor.useRpcExport": {
					"type": "boolean",
					"default": true,
					"description": "启用后，将尝试通过内部 RPC 将对话导出为本地 JSONL 产物以解析精准 Token 使用量。"
				},
				"antigravity-token-monitor.exportStepsJsonl": {
					"type": "boolean",
					"default": false,
					"description": "启用后，同时将对话步骤导出到 steps.jsonl 中。"
				},
				"antigravity-token-monitor.rpcExportIntervalMs": {
					"type": "number",
					"default": 300000,
					"minimum": 10000,
					"description": "启用 RPC 导出时，后台导出 Antigravity 会话的时间间隔（毫秒）。"
				},
				"antigravity-token-monitor.rpcTimeoutMs": {
					"type": "number",
					"default": 5000,
					"minimum": 1000,
					"description": "内部 Antigravity RPC 请求的超时时间（毫秒）。"
				}
			}
		}
	},
	"scripts": {
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "npm run compile && npx @vscode/vsce package --no-dependencies",
		"typecheck": "tsc --noEmit",
		"typecheck:webview": "svelte-check --tsconfig ./tsconfig.webview.json",
		"test:webview": "vitest run"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.7.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^20.17.30",
		"@types/vscode": "^1.96.0",
		"esbuild": "^0.25.0",
		"esbuild-svelte": "^0.9.4",
		"jsdom": "^28.1.0",
		"svelte": "^5.53.9",
		"svelte-check": "^4.4.5",
		"typescript": "^5.8.2",
		"vitest": "^4.0.18"
	}
}
